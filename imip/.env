# ─── Flask ───────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# ─── Segurança ───────────────────────────────────
# Troque por uma string longa e aleatória antes de subir para produção
SECRET_KEY=imip-dev-secret-troque-em-producao

# ─── Banco de dados ──────────────────────────────
DATABASE_PATH=database/imip.db

# ─── Sessão ──────────────────────────────────────
SESSION_LIFETIME_HOURS=8

# ─── Ambiente ────────────────────────────────────
# development | production
APP_ENV=development